{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                // 保留原有的系统头文件路径
                "/usr/src/linux-headers-5.4.0-86-generic/include",
                "/usr/src/linux-headers-5.4.0-86-generic/arch/x86/include",
                // 添加当前工作区目录（关键）：递归包含所有子目录
                "${workspaceFolder}/**"
            ],
            "defines": ["__KERNEL__", "MODULE"],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu17",  // 确保与代码标准一致（如内核用gnu17）
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}